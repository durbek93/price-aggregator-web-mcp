# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_IDS=123456789,123456789

# Security Settings
JWT_SECRET=some_very_long_random_string_for_signing_tokens

# API Configurations
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Internal security key for agent communications
INTERNAL_API_KEY=internal_secret_api_key_98765

# Telegram Group ID for automated posting
TELEGRAM_GROUP_ID=-123456789

# Scout Agent (Userbot) Pyrogram Settings
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_string
TELEGRAM_PHONE=+123456789
DISTRIBUTOR_CHANNELS=-123456789,your_channel_username

# Analyst Agent (aiogram bot) Settings
ANALYST_BOT_TOKEN=your_analyst_bot_token_here
GEMINI_API_KEY=your_gemini_api_key_here

# Debugger / Auditor Agent (aiogram bot) Settings
DEBUGGER_BOT_TOKEN=your_debugger_bot_token_here

